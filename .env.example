# ===================================================
# VocabFlow Environment Variables Example
# ===================================================

# Supabase Configuration (Optional for guest mode, required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===================================================
# Image Provider Abstraction (Prompt 5)
# ===================================================
# Provider choices: 'curated' (offline default), 'unsplash', 'pexels', 'placeholder'
IMAGE_PROVIDER=curated

# External Provider API Keys (Server-side only, NEVER prefix with NEXT_PUBLIC_)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# Image Search & Safety Configuration
IMAGE_SAFE_SEARCH=true
IMAGE_CACHE_TTL_HOURS=24

# ===================================================
# Audio & Text-to-Speech Providers (Optional)
# ===================================================
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
